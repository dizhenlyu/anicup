# C02 runs without an env file. No credentials are needed or read.
# Reserved for later checkpoints; these switches are not implemented in C02.
# APP_ORIGIN=http://localhost:3000
# CATALOG_MODE=fixture
# DATABASE_URL=postgresql://anicup:local_only@localhost:5432/anicup
# SESSION_KEY_VERSION=v1
# RECOVERY_KEY_VERSION=v1
# RATE_LIMIT_KEY_VERSION=v1
# ALLOWED_ASSET_HOSTS=
# ANALYTICS_ENABLED=false
# CUP_IDLE_RETENTION_DAYS=30
# PUBLICATION_RETENTION_DAYS=180
# RATE_LIMIT_WINDOW_SECONDS=60
# Source/version configuration for deployment will be introduced with C06.
